{
  "name": "@leitware/email-templates",
  "version": "0.1.0",
  "description": "A composable directory of business email templates, best practices, and guides",
  "type": "module",
  "bin": {
    "email-templates": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
